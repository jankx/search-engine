<div class="jankx-search-keyword" data-settings="{$atts|json}">
    <div class="search-bar-wrapper">
        <input type="text" name="q" placeholder="{$atts['placeholder'] ?? 'Search...'}" class="search-input">
        <button type="submit" class="search-btn">
            <i class="icon-search"></i>
        </button>
    </div>
</div>
