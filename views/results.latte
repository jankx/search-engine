<div class="jankx-search-results-container {(!empty($atts['enable_video_popup']) && ($atts['enable_video_popup'] === 'true' || $atts['enable_video_popup'] === true)) ? 'has-video-popup' : ''}" data-settings="{$atts|json}">
    {* Featured Section if enabled *}
    <div n:if="!empty($atts['show_featured']) && ($atts['show_featured'] === 'true' || $atts['show_featured'] === true)" class="featured-results">
        {do do_action('jankx_search_render_featured', $atts)}
    </div>

    <div class="search-results {$layout_class}">
        <div class="results-grid">
            {do do_action('jankx_search_results_initial_render', $atts)}
        </div>
    </div>

    <div n:if="!empty($atts['show_pagination']) && ($atts['show_pagination'] === 'true' || $atts['show_pagination'] === true)" class="container pagination-container">
        {do do_action('jankx_search_render_pagination', $atts)}
    </div>
</div>
